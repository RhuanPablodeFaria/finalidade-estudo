{
  "Logging": {
  },
  "DatabaseSettings": {
    "ConnectionString": "Server=localhost,1433;Database=FinalidadeEstudoDB;User Id=sa;Password=MinhaSenhaForte@123;TrustServerCertificate=True"
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
